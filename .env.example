# Backend
PORT=3001
NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=marketscope
DATABASE_PASSWORD=marketscope
DATABASE_NAME=marketscope

# Server-side Google APIs (Geocoding + Places API New). Do not commit real keys.
GOOGLE_MAPS_API_KEY=

# Frontend (Vite) — HTTP-referrer restricted key for Maps JavaScript API
# Vite loads this from the repo root (frontend/vite.config.ts envDir: "..")
# Frontend talks to the API via the Vite /api proxy (see frontend/vite.config.ts)
VITE_GOOGLE_MAPS_API_KEY=
